# --- Personal files: never commit these ---
# The resume contains a phone number and a personal email address. This repo is
# public, so committing it would put both in front of every scraper on GitHub —
# and in the history permanently, even if deleted later.
*.pdf
*.docx
*.doc
Rameez_Rahaman_Resume.pdf
Rameez_Rahaman_Resume.docx

# --- Xcode ---
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Xcode project user-specific settings. The shared scheme files ARE committed
# (that's xcshareddata), only per-user state is ignored.
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
*.xcworkspace/xcuserdata/

# --- Swift Package Manager ---
.build/
.swiftpm/
Package.resolved

# --- CocoaPods / Carthage (not used, but harmless to guard against) ---
Pods/
Carthage/Build/

# --- Secrets ---
# Any API keys or credentials go in a file matching these patterns, never inline.
Secrets.swift
Secrets.plist
*.env
.env.local

# --- Screenshots ---
# The Lock Screen and Home Screen shots are photographic wallpapers, so they're
# committed as JPEG. The PNG originals are 5-10x larger for no visible gain.
screenshots/live-activity.png
screenshots/dynamic-island.png

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
